<?xml version="1.0" encoding="UTF-8"?>
<!-- The benchmark agent of QuickFIX/J: see Agent.java. mvn package builds
     target/quickfixj-agent.jar, holding its dependencies. -->
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
  <modelVersion>4.0.0</modelVersion>

  <groupId>com.github.sylr.fix2.benchmarks</groupId>
  <artifactId>quickfixj-agent</artifactId>
  <version>0</version>
  <packaging>jar</packaging>

  <properties>
    <quickfixj.version>3.0.2</quickfixj.version>
    <!-- The slf4j-api QuickFIX/J depends on. -->
    <slf4j.version>2.0.18</slf4j.version>
    <maven.compiler.release>25</maven.compiler.release>
    <project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>
  </properties>

  <dependencies>
    <dependency>
      <groupId>org.quickfixj</groupId>
      <artifactId>quickfixj-core</artifactId>
      <version>${quickfixj.version}</version>
    </dependency>
    <!-- QuickFIX/J logs its own events through SLF4J: to nowhere, as the
         other agents' engines log nothing. -->
    <dependency>
      <groupId>org.slf4j</groupId>
      <artifactId>slf4j-nop</artifactId>
      <version>${slf4j.version}</version>
      <scope>runtime</scope>
    </dependency>
  </dependencies>

  <build>
    <finalName>quickfixj-agent</finalName>
    <resources>
      <resource>
        <directory>src/main/resources</directory>
        <filtering>true</filtering>
      </resource>
    </resources>
    <plugins>
      <!-- The message and field classes, generated from the benchmarks'
           dictionary as QuickFIX/J generates its own published ones
           (quickfixj-messages-all): doubles for prices and quantities,
           fields in ascending order, no timestamp precision. -->
      <plugin>
        <groupId>org.quickfixj</groupId>
        <artifactId>quickfixj-codegenerator</artifactId>
        <version>${quickfixj.version}</version>
        <dependencies>
          <!-- The plugin's FileUtils, which Maven 3.9 no longer provides. -->
          <dependency>
            <groupId>org.codehaus.plexus</groupId>
            <artifactId>plexus-utils</artifactId>
            <version>4.0.2</version>
          </dependency>
        </dependencies>
        <executions>
          <execution>
            <id>fix44</id>
            <goals>
              <goal>generate</goal>
            </goals>
            <configuration>
              <dictFile>${project.basedir}/../../spec/FIX44.xml</dictFile>
              <outputDirectory>${project.build.directory}/generated-sources/quickfixj</outputDirectory>
              <packaging>quickfix.fix44</packaging>
              <fieldPackage>quickfix.field</fieldPackage>
              <decimal>false</decimal>
            </configuration>
          </execution>
        </executions>
      </plugin>
      <!-- As quickfixj-messages-all does: the session fields quickfixj-base
           ships are removed from what is generated, and the CHAR constants
           of two characters the dictionary defines (MiscFeeType 10 to 12,
           MassCancelRejectReason 99), which would not compile. -->
      <plugin>
        <groupId>org.apache.maven.plugins</groupId>
        <artifactId>maven-antrun-plugin</artifactId>
        <version>3.1.0</version>
        <executions>
          <execution>
            <id>fix-generated-fields</id>
            <phase>process-sources</phase>
            <goals>
              <goal>run</goal>
            </goals>
            <configuration>
              <target>
                <delete>
                  <fileset dir="${project.build.directory}/generated-sources/quickfixj/quickfix/field"
                           includes="ApplExtID.java,ApplVerID.java,BeginSeqNo.java,BeginString.java,BodyLength.java,BusinessRejectReason.java,CheckSum.java,CstmApplVerID.java,DefaultApplVerID.java,DeliverToCompID.java,DeliverToLocationID.java,DeliverToSubID.java,EncryptMethod.java,EndSeqNo.java,GapFillFlag.java,HeartBtInt.java,LastMsgSeqNumProcessed.java,MessageEncoding.java,MsgSeqNum.java,MsgType.java,NewSeqNo.java,NextExpectedMsgSeqNum.java,NoHops.java,OnBehalfOfCompID.java,OnBehalfOfLocationID.java,OnBehalfOfSendingTime.java,OnBehalfOfSubID.java,OrigSendingTime.java,PossDupFlag.java,PossResend.java,RefMsgType.java,RefSeqNum.java,RefTagID.java,ResetSeqNumFlag.java,SecureData.java,SecureDataLen.java,SenderCompID.java,SenderLocationID.java,SenderSubID.java,SendingTime.java,SessionRejectReason.java,SessionStatus.java,Signature.java,SignatureLength.java,TargetCompID.java,TargetLocationID.java,TargetSubID.java,TestReqID.java,Text.java,XmlData.java,XmlDataLen.java"/>
                </delete>
                <replaceregexp byline="true" match="^\s*public static final char \w+ = '[^']{2,}';\s*$" replace="">
                  <fileset dir="${project.build.directory}/generated-sources/quickfixj/quickfix/field" includes="*.java"/>
                </replaceregexp>
              </target>
            </configuration>
          </execution>
        </executions>
      </plugin>
      <plugin>
        <groupId>org.apache.maven.plugins</groupId>
        <artifactId>maven-compiler-plugin</artifactId>
        <version>3.13.0</version>
      </plugin>
      <plugin>
        <groupId>org.apache.maven.plugins</groupId>
        <artifactId>maven-shade-plugin</artifactId>
        <version>3.6.0</version>
        <executions>
          <execution>
            <phase>package</phase>
            <goals>
              <goal>shade</goal>
            </goals>
            <configuration>
              <createDependencyReducedPom>false</createDependencyReducedPom>
              <transformers>
                <transformer implementation="org.apache.maven.plugins.shade.resource.ManifestResourceTransformer">
                  <mainClass>fix2bench.Agent</mainClass>
                  <manifestEntries>
                    <!-- cpuTime calls getrusage(2). -->
                    <Enable-Native-Access>ALL-UNNAMED</Enable-Native-Access>
                  </manifestEntries>
                </transformer>
                <transformer implementation="org.apache.maven.plugins.shade.resource.ServicesResourceTransformer"/>
              </transformers>
              <filters>
                <filter>
                  <artifact>*:*</artifact>
                  <excludes>
                    <exclude>META-INF/*.SF</exclude>
                    <exclude>META-INF/*.DSA</exclude>
                    <exclude>META-INF/*.RSA</exclude>
                  </excludes>
                </filter>
              </filters>
            </configuration>
          </execution>
        </executions>
      </plugin>
    </plugins>
  </build>
</project>
